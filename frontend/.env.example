# Public Express API base URL. Included in the browser bundle where client components use it.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required by the admin authentication flow; these values are safe to expose with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
