# Required public Express API base URL. There is intentionally no localhost fallback.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by the admin authentication flow; these values are safe to expose with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only fallback for owner authentication. Prefer app_metadata.portfolio_owner.
PORTFOLIO_OWNER_EMAILS=owner@example.com

# Server-only shared secret used by the Supabase Database Webhook.
REVALIDATE_SECRET=replace-with-a-long-random-value
