PORT=5000
FRONTEND_URL=http://localhost:3000
DEVELOPMENT_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=16kb

# Supabase project settings. Keep the service-role key server-side and secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated accounts allowed to use portfolio owner endpoints.
PORTFOLIO_OWNER_EMAILS=owner@example.com
